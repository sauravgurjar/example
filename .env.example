# Server-side proxy settings (restart Vite after changes).
ASKNOW_API_ORIGIN=https://asknow-uat.hdfcbankuat.com
# Optional SESSION / gateway cookies, excluding access-token, from your current UAT session.
ASKNOW_SESSION_COOKIES=
# Keep false unless your UAT environment explicitly requires curl's --insecure behavior.
ASKNOW_ALLOW_INSECURE_TLS=false
